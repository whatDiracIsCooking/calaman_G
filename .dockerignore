# Keep the build context small: everything here is either rebuilt inside the
# image, irrelevant to it, or large. A fat context slows every rebuild.
#
# What the images DO need from the context is short -- pyproject.toml + uv.lock
# for the venv, and docker/install-{cuda,rocm}.sh, which the GPU stages
# bind-mount rather than COPY.

.git/
.github/
.claude/

# CMake output (every preset's dir, plus the compile database and module cache)
build*/
cmake-build-*/
compile_commands.json
.cache/

# Run artifacts
.log/
.slow-tier-reports/

# Python
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/
dist/
scratch/

# Local environment
docker/.env
*.local
.DS_Store

# Profiling output
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Vendored third-party source belongs to `git submodule update`, not to the
# image. Add this project's submodule paths here.

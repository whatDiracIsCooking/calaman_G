# syntax=docker/dockerfile:1.7
# ============================================================================
# cuda -- base + the CUDA toolkit. THE DEFAULT BACKEND.
# ============================================================================
# What .devcontainer/cuda/devcontainer.json and docker/compose.yaml build, and
# the only image the repo's normal workflow needs.
#
#   docker/build.sh cuda      # builds base first, then this; tags :cuda, :latest
#
# By hand, and the parent must already be tagged (see Dockerfile.base, "WHY THE
# FOUR FILES CHAIN BY TAG"):
#
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.base -t calaman:base .
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.cuda -t calaman:latest .
#
# Both from the REPO ROOT: the trailing `.` is the context, and this file
# bind-mounts docker/install-cuda.sh from it.
#
# Pick CUDA_VERSION against the HOST DRIVER, not against the newest CUDA: a
# driver whose ceiling is below the image's CUDA version makes the container
# refuse to start under `--gpus all` with
#   nvidia-container-cli: requirement error: unsatisfied condition: cuda>=X.Y
# `nvidia-smi` reports the driver's ceiling as "CUDA Version:". Note also that
# CUDA 13 dropped Maxwell/Pascal/Volta -- its nvcc floor is compute_75. The
# WarpWraps dependency's floor is higher still: sm_80 (Ampere), enforced at
# configure in deps/WarpWraps/CMakeLists.txt (it wraps and tests bf16 WMMA) and
# so inherited by this project's build. A pre-Ampere card is unsupported
# regardless of toolkit, which is why the `volta` preset stays dropped from
# CMakePresets.json.
ARG PROJECT_NAME=calaman
ARG PARENT_IMAGE=${PROJECT_NAME}:base
FROM ${PARENT_IMAGE}

ARG CUDA_VERSION=13-0
ARG TARGETARCH
USER root

# Re-stamped rather than merely inherited from the parent, so that the
# PROJECT_NAME the devcontainer passes to THIS build is consumed where it is
# declared. See Dockerfile.base for what the label is for.
ARG PROJECT_NAME
LABEL devcontainer.project="${PROJECT_NAME}"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=bind,source=docker/install-cuda.sh,target=/tmp/install-cuda.sh \
    CUDA_VERSION="${CUDA_VERSION}" TARGETARCH="${TARGETARCH}" bash /tmp/install-cuda.sh

# Set by the nvidia/cuda base images, and required by the NVIDIA container
# runtime to inject the driver under `--gpus all`. Building on plain Ubuntu
# means setting them here instead.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Version-independent symlink, so a toolkit bump (13.0 -> 13.1) does not leave
# these pointing at a directory that no longer exists.
ENV CUDAToolkit_ROOT=/usr/local/cuda \
    CUDACXX=/usr/local/cuda/bin/nvcc \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# cuGraph, which is NOT in the CUDA repo the layer above installs from -- it is
# RAPIDS, and ships as a wheel. install-cugraph.sh has why that is acceptable
# here and why it is deliberately not a pyproject.toml dependency.
#
# The two versions differ because RAPIDS releases libcuvs on its own cadence;
# they are separate args so a bump does not have to move both. This is the
# heaviest single addition to this image (~770MB of wheels), so it is also the
# first thing to look at if :cuda-ci pull time becomes the CI bottleneck.
ARG CUGRAPH_VERSION=26.8.0
ARG CUVS_VERSION=26.8.1
RUN --mount=type=bind,source=docker/install-cugraph.sh,target=/tmp/install-cugraph.sh \
    CUDA_VERSION="${CUDA_VERSION}" CUGRAPH_VERSION="${CUGRAPH_VERSION}" \
    CUVS_VERSION="${CUVS_VERSION}" bash /tmp/install-cugraph.sh

# The three libraries added on top of the toolkit -- cuTENSOR, nvCOMP, cuGraph
# -- all install OFF the default search paths, so this is what makes
# find_package/find_path see them. /opt/nvidia/* are the fixed-name prefixes
# install-cuda.sh builds by discovery; /opt/rapids/* are the wheel directories.
#
# NOTE for anything that configures with an explicit -DCMAKE_PREFIX_PATH: a
# -D cache entry SHADOWS this variable rather than extending it
# (devtools/install-check.sh passes one), so such a caller has to append these
# itself once the build depends on them.
ENV CMAKE_PREFIX_PATH=/opt/nvidia/cutensor:/opt/nvidia/nvcomp:/opt/rapids/libcugraph:/opt/rapids/libraft:/opt/rapids/librmm:/opt/rapids/libcuvs

# The target architecture, as a build arg so a cluster build can widen it:
#   --build-arg CUDA_ARCH="80;86;90"
# 86 is Ampere consumer (RTX 30xx). CUDAARCHS is what CMake reads when a preset
# does not set CMAKE_CUDA_ARCHITECTURES; the `default` preset sets it to
# `native`, which compiles only for the card in the build machine -- use the
# ci-cuda preset, which pins 86, when the build host has no card. Keep this at
# 80 or above: the WarpWraps dependency's sm_80 (Ampere) floor (see the
# CUDA_VERSION note at the top of this file) fails at CONFIGURE time, well
# before the toolkit's own compute_75 floor is reached. There are no
# per-architecture presets; devtools/config.sh has why.
ARG CUDA_ARCH=86
ENV CUDA_ARCH=${CUDA_ARCH} \
    CUDAARCHS=${CUDA_ARCH}

# Nsight Systems CLI, for profiling from inside the container. Non-fatal: the
# repository is occasionally unavailable, and nothing else depends on nsys.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    repo="https://developer.download.nvidia.com/devtools/repos/ubuntu2404/${TARGETARCH}" && \
    ( wget -qO /etc/apt/trusted.gpg.d/nvidia-devtools.asc "${repo}/nvidia.pub" && \
      echo "deb ${repo}/ /" > /etc/apt/sources.list.d/nvidia-devtools.list && \
      apt-get update && apt-get install -y --no-install-recommends nsight-systems-cli ) \
    || echo "WARN: nsight-systems-cli unavailable; nsys will be missing (doctor.sh reports it)"

# Claude Code, PINNED -- the last root layer in this file on purpose: a version
# bump re-runs only this and the two lines after it, never the SDK above it.
# docker/install-claude-code.sh carries the rest (why not Dockerfile.base, and
# which drift this ended). It is the fourth version to bump in more than one
# place: the same ARG is declared by Dockerfile.cuda, .hip and .combined, so
# bump it with `devtools/claude-version.sh --apply`, which rewrites all three
# at once -- doctor.sh warns when they have drifted apart.
#
# ENV as well as ARG so the INTENDED version is readable from inside a running
# container (`printenv CLAUDE_CODE_VERSION`), not merely inferable from the
# binary: that is what lets doctor.sh tell "pinned and installed" apart from
# "someone npm-installed over the top".
ARG CLAUDE_CODE_VERSION=2.1.292
ENV CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION}
RUN --mount=type=bind,source=docker/install-claude-code.sh,target=/tmp/install-claude-code.sh \
    bash /tmp/install-claude-code.sh

USER ubuntu
RUN nvcc --version | grep release

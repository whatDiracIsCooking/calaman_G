# syntax=docker/dockerfile:1.7
# ============================================================================
# base -- the vendor-neutral C++23 toolchain, and the parent of every GPU image
# ============================================================================
# Four files, one diamond. This is the top of it:
#
#                       Dockerfile.base
#                        /           \
#         Dockerfile.cuda             Dockerfile.hip
#                   |                       :
#         Dockerfile.combined ..............:
#                                (reuses install-rocm.sh, not the hip image)
#
# Everything the build needs EXCEPT a GPU SDK: clang-20 with libc++, CMake 4.2,
# Ninja, sccache, the CPU reference LAPACK the tests check their results
# against, and a uv-managed venv for the Python tooling. Useful on its own to
# check the toolchain half in isolation, and the shared parent of `cuda` and
# `hip` so the two cannot drift apart.
#
#   docker/build.sh base          # the normal way: tags <PROJECT_NAME>:base
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.base -t calaman:base .
#
# RUN THAT FROM THE REPO ROOT. The trailing `.` is the build context and it is
# the repo root, not this directory: this file COPYs pyproject.toml and uv.lock,
# spelled relative to that root. `docker build -f Dockerfile.base .` from inside
# docker/ dies on the first COPY.
#
# WHY THE FOUR FILES CHAIN BY TAG INSTEAD OF BY STAGE:
# these were one multi-stage Dockerfile, where `FROM base` resolved a stage in
# the same file and a single `docker build --target cuda` did everything. Split
# apart, a child can only name an IMAGE, so it takes an ARG:
#
#   ARG PARENT_IMAGE=calaman:base
#   FROM ${PARENT_IMAGE}
#
# which means the parent must exist and be tagged BEFORE the child builds. That
# ordering is the whole cost of the split, and `docker/build.sh` is what pays it
# -- it walks the chain for whichever target you name. Build a child by hand
# with no parent tagged and docker does not fall back to building it; it tries
# to PULL, and fails with `pull access denied for calaman, repository does not
# exist`, which reads like a registry problem rather than a missing local build.
#
# The .devcontainer/*/devcontainer.json files run exactly one `docker build` and
# have no way to pre-build a parent, so each one carries an `initializeCommand`
# that calls build.sh for its parent first.
#
# WHY THE TOOLKIT COMES FROM APT, NOT FROM nvidia/cuda:
# this file cannot be both nvidia/cuda and rocm/dev-ubuntu at once, and
# duplicating the LLVM/CMake stages per vendor is how they drift. The
# nvidia/cuda images are Ubuntu plus the same apt packages, so the only thing
# lost is the NVIDIA_* runtime env they set -- which Dockerfile.cuda sets back
# explicitly. ROCm is ~30GB installed, which is the whole reason `hip` is a
# separate image rather than everything living in one.
#
# Build one stage of THIS file in isolation to debug it:
#   docker build --target=compilers -f docker/Dockerfile.base -t dbg:compilers .
#
# ---------------------------------------------------------------------------
# WHY THE VERSIONS BELOW ARE PINNED HERE AND NOT DISCOVERED
# ---------------------------------------------------------------------------
# `import std` needs three things to agree: clang, libc++'s module manifest,
# and CMake's experimental import-std UUID (set in CMakeLists.txt, and specific
# to the CMake version). Floating any one of them turns a working build into
# "module 'std' not found" with no other symptom. Bump them together, and
# re-check the UUID in the new CMake's Help/dev/experimental.rst.
#
# The two SDK versions are NOT here: CUDA_VERSION lives in Dockerfile.cuda and
# ROCM_VERSION in Dockerfile.hip / Dockerfile.combined, beside the install
# script each one drives.
ARG UBUNTU_TAG=24.04
ARG LLVM_VERSION=20
ARG CMAKE_VERSION=4.2.3
ARG CMAKE_MAJOR_MINOR=4.2
ARG NINJA_VERSION=1.13.1
# Not in apt at any usable version, so it comes from the upstream release
# tarball like CMake and Ninja do. 0.18 is the floor: it is the version
# measured to cache a module-interface compile (two outputs, one invocation),
# which is the only reason this image carries a compiler cache at all.
ARG SCCACHE_VERSION=0.18.0

# ============================================================================
# Stage 1: base-system -- OS packages every later stage shares
# ============================================================================
FROM ubuntu:${UBUNTU_TAG} AS base-system

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# The CPU reference LAPACK is in this stage, not in a GPU child: it is host
# code, it is what the tests compare a GPU factorisation AGAINST, and both
# backends need the same one. Ubuntu 24.04 ships LAPACK 3.12.0.
#
#   liblapack-dev    reference (netlib) LAPACK + the BLAS it needs
#   liblapacke-dev   LAPACKE, the C interface -- /usr/include/lapacke.h. The
#                    Fortran ABI is not something to call by hand from C++23.
#   gfortran         not needed to LINK (libgfortran5 arrives as a dependency);
#                    here so a Fortran reference routine can be compiled when
#                    LAPACKE does not expose one.
#
# REFERENCE RATHER THAN OpenBLAS, AND THAT IS THE POINT. An oracle has to be
# deterministic, and a threaded BLAS is not bitwise reproducible across thread
# counts -- a tolerance failure would then depend on the machine's core count.
#
# THE TRAP IF SOMEONE ADDS OpenBLAS LATER: on Debian/Ubuntu
# /usr/lib/*/liblapack.so is an update-alternatives symlink, so installing
# libopenblas-dev REPOINTS it and every test silently starts checking against a
# threaded implementation while nothing in this file changed. Install it under
# its own name and link it explicitly, or hold the alternative
# (`update-alternatives --set liblapack.so-x86_64-linux-gnu ...`) in the same
# layer.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache && \
    apt-get update && apt-get install -y --no-install-recommends \
      bash build-essential ca-certificates curl git gnupg jq less \
      lcov patch pkg-config shellcheck software-properties-common ssh tree \
      unzip valgrind vim-tiny wget zlib1g-dev \
      gfortran liblapack-dev liblapacke-dev \
    && git --version && wget --version | head -1 \
    && test -f /usr/include/lapacke.h

# ============================================================================
# Stage 2: downloads -- CMake and Ninja tarballs (independent of base-system,
# so BuildKit runs it concurrently)
# ============================================================================
FROM ubuntu:${UBUNTU_TAG} AS downloads

ARG CMAKE_VERSION
ARG NINJA_VERSION
ARG SCCACHE_VERSION
# Supplied automatically by BuildKit: "amd64" or "arm64".
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Upstream asset names differ per architecture, so they are resolved here and
# staged under arch-independent filenames for the next stage to consume.
RUN --mount=type=cache,target=/download-cache \
    set -e; \
    case "$TARGETARCH" in \
      amd64) cmake_arch=x86_64;  ninja_asset=ninja-linux.zip; \
             sccache_arch=x86_64 ;; \
      arm64) cmake_arch=aarch64; ninja_asset=ninja-linux-aarch64.zip; \
             sccache_arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH: '$TARGETARCH'" >&2; exit 1 ;; \
    esac; \
    cmake_asset="cmake-${CMAKE_VERSION}-linux-${cmake_arch}.sh"; \
    sccache_dir="sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl"; \
    mkdir -p /downloads; \
    [ -f "/download-cache/${cmake_asset}" ] || \
      wget -q -O "/download-cache/${cmake_asset}" \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${cmake_asset}"; \
    [ -f "/download-cache/ninja-${NINJA_VERSION}-${ninja_asset}" ] || \
      wget -q -O "/download-cache/ninja-${NINJA_VERSION}-${ninja_asset}" \
        "https://github.com/ninja-build/ninja/releases/download/v${NINJA_VERSION}/${ninja_asset}"; \
    [ -f "/download-cache/${sccache_dir}.tar.gz" ] || \
      wget -q -O "/download-cache/${sccache_dir}.tar.gz" \
        "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/${sccache_dir}.tar.gz"; \
    cp "/download-cache/${cmake_asset}" /downloads/cmake-installer.sh; \
    cp "/download-cache/ninja-${NINJA_VERSION}-${ninja_asset}" /downloads/ninja.zip; \
    chmod +x /downloads/cmake-installer.sh; \
    tar -xzf "/download-cache/${sccache_dir}.tar.gz" -C /tmp; \
    install -m 0755 "/tmp/${sccache_dir}/sccache" /downloads/sccache

# ============================================================================
# Stage 3: compilers -- LLVM/clang with libc++ and its module manifest
# ============================================================================
FROM base-system AS compilers

ARG LLVM_VERSION

# libc++-dev is the load-bearing one: it ships libc++.modules.json, which is
# what CMakeLists.txt globs /usr/lib/llvm-*/lib for to resolve `import std`.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    wget -qO /etc/apt/trusted.gpg.d/llvm-snapshot.asc https://apt.llvm.org/llvm-snapshot.gpg.key && \
    add-apt-repository "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-${LLVM_VERSION} main" && \
    apt-get update && apt-get install -y --no-install-recommends --fix-missing \
      llvm-${LLVM_VERSION} \
      clang-${LLVM_VERSION} \
      clang-tidy-${LLVM_VERSION} \
      clang-format-${LLVM_VERSION} \
      clangd-${LLVM_VERSION} \
      clang-tools-${LLVM_VERSION} \
      libclang-rt-${LLVM_VERSION}-dev \
      libc++-${LLVM_VERSION}-dev \
      libc++abi-${LLVM_VERSION}-dev \
      cppcheck

# The versioned binaries live in /usr/lib/llvm-N/bin, which is not on PATH.
# clang-scan-deps is included: CMake's module scanner, and a FATAL_ERROR in
# CMakeLists.txt when it is missing. llvm-objdump and llvm-cxxfilt are here for
# test/extension/build_time's blas dispatch check, which disassembles the
# instantiations and demangles what they call.
RUN for tool in clang clang++ clang-tidy clang-format clangd clang-scan-deps \
                llvm-objdump llvm-cxxfilt; do \
      update-alternatives --install /usr/bin/$tool $tool /usr/bin/${tool}-${LLVM_VERSION} 100; \
    done && \
    clang --version | grep -q "${LLVM_VERSION}\." && \
    clang-scan-deps --version && \
    llvm-objdump --version | head -1 && \
    test -f /usr/lib/llvm-${LLVM_VERSION}/lib/libc++.modules.json

# ============================================================================
# Stage 4: build-tools -- CMake and Ninja onto a base-system layer
# ============================================================================
FROM base-system AS build-tools

ARG CMAKE_VERSION

COPY --link --from=downloads /downloads/cmake-installer.sh /tmp/
COPY --link --from=downloads /downloads/ninja.zip /tmp/

RUN cd /tmp && ./cmake-installer.sh --skip-license --prefix=/usr/local && rm cmake-installer.sh && \
    unzip -q ninja.zip && mv ninja /usr/local/bin/ && chmod +x /usr/local/bin/ninja && rm ninja.zip && \
    cmake --version | grep -q "${CMAKE_VERSION}" && ninja --version

# ============================================================================
# Stage 5: base -- the complete, vendor-neutral toolchain
# ============================================================================
# The published stage of this file, and what Dockerfile.{cuda,hip} take as
# their PARENT_IMAGE.
#
# The only prebuilt C++ dependency here is the CPU reference LAPACK (stage 1),
# which is a distro package because it is an oracle rather than a component:
# nothing under src/ links it. The two dependencies this project BUILDS come
# from source at configure time -- WarpWraps from the deps/WarpWraps submodule, and
# GoogleTest fetched by deps/CMakeLists.txt -- so nothing in /opt has to be
# kept in step with the tree.
FROM compilers AS base

ARG CMAKE_MAJOR_MINOR
ARG LLVM_VERSION

# This label is what scopes `devtools/worktree.sh gc` to this project's build
# images, so it cannot delete another repo's. Must match PROJECT_NAME in
# devtools/config.sh -- devtools/doctor.sh warns when they drift. Labels are
# inherited, so the GPU children carry it too; each of those re-stamps it
# anyway, to keep the build arg they are passed consumed where it is declared.
ARG PROJECT_NAME=calaman
LABEL devcontainer.project="${PROJECT_NAME}"

COPY --link --from=build-tools /usr/local/bin/cmake /usr/local/bin/cmake
COPY --link --from=build-tools /usr/local/bin/ctest /usr/local/bin/ctest
COPY --link --from=build-tools /usr/local/bin/cpack /usr/local/bin/cpack
COPY --link --from=build-tools /usr/local/bin/ninja /usr/local/bin/ninja
# The compiler cache, wired in by CMakeLists.txt (find_program) rather than by
# a preset, so an image or host without it still builds -- it just caches
# nothing. See the "Compiler cache" section there for why it is sccache.
COPY --link --from=downloads /downloads/sccache /usr/local/bin/sccache
# CMake installs to share/cmake-<MAJOR>.<MINOR>, not -<MAJOR>.<MINOR>.<PATCH>.
COPY --link --from=build-tools /usr/local/share/cmake-${CMAKE_MAJOR_MINOR} /usr/local/share/cmake-${CMAKE_MAJOR_MINOR}

# --- Python -----------------------------------------------------------------
# One uv-managed venv at /opt/venv, installed `--frozen` from the committed
# lock, so the container and the host cannot drift. This is why there is no pip install list in here -- add a dependency
# to pyproject.toml, run `uv lock`, commit both.
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /usr/local/bin/

# UV_PYTHON_INSTALL_DIR is load-bearing, not tidiness. pyproject requires
# Python >=3.13 and this layer has no such system interpreter, so `uv sync`
# downloads a uv-managed CPython and points /opt/venv/bin/python at it. By
# default that lands in the BUILD user's home -- /root/.local/share/uv/python --
# and /root is 0700, so uid 1000 cannot traverse it: chowning /opt/venv fixes
# the symlink's inode and not its target, and the venv is dead for the user the
# container actually runs as. Sending the interpreter to /opt/uv/python puts it
# somewhere every uid can reach, and keeps it there at runtime too, so a later
# `uv sync` in the workspace reuses it instead of re-downloading into $HOME.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python
COPY pyproject.toml uv.lock /tmp/uvroot/
RUN cd /tmp/uvroot && uv sync --frozen --no-install-project && rm -rf /tmp/uvroot && \
    chown -R 1000:1000 /opt/venv /opt/uv

# Ubuntu 24.04 ships an `ubuntu` user at uid 1000, which matches a typical
# single-user host, so files written into the bind mount stay owned by you.
# .devcontainer/*.json set `remoteUser: ubuntu`; docker/compose.yaml instead
# passes HOST_UID:HOST_GID, which is why /opt/venv is group-readable rather
# than owned by a user this image had to invent.
RUN install -d -o 1000 -g 1000 \
        /workspace \
        /tmp/pytest-of-ubuntu \
        /home/ubuntu/.sccache \
        /home/ubuntu/.claude/plugins \
        /home/ubuntu/.claude/backups

# SCCACHE_DIR is a FIXED path inside the image on purpose, not a workspace-
# relative one: the shared store is bind-mounted onto it, so one value works
# from every checkout no matter where its workspace lands -- which is the whole
# point for .claude/worktrees/<name>, whose mount does not contain the primary
# checkout's store. .devcontainer/*/devcontainer.json and docker/compose.yaml
# both bind here; devtools/devcontainer.sh creates the host directory first,
# because docker would otherwise create it as root and the first compile would
# die on a permission error that never mentions a mount.
#
# The 20G ceiling is sccache's own eviction bound, and it applies to the host
# directory rather than docker's storage, so it is not what builder.gc prunes.
ENV SCCACHE_DIR=/home/ubuntu/.sccache \
    SCCACHE_CACHE_SIZE=20G \
    PATH=/opt/venv/bin:/usr/local/bin:${PATH}

WORKDIR /workspace

RUN clang --version | head -1 && \
    cmake --version | head -1 && \
    ninja --version && \
    sccache --version && \
    test -f /usr/lib/llvm-${LLVM_VERSION}/lib/libc++.modules.json && \
    test -f /usr/include/lapacke.h && \
    gfortran --version | head -1

USER ubuntu

# The venv smoke test belongs HERE, after the USER switch, because the bug it
# guards against is a permission one: a venv that works for root and not for
# uid 1000. It also has to do more than `python3 --version` -- an interpreter
# whose stdlib is unreadable still prints its version, then dies on `import
# encodings`, which is exactly how the /root leak above shipped unnoticed. So
# import something, and run two entry points through the venv's shebang.
RUN python3 -c "import json, sys; print(sys.version.split()[0], sys.executable)" && \
    pre-commit --version && \
    pytest --version

CMD ["/bin/bash"]
